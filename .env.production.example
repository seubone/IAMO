# ==================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==================================
# Copy this file to .env.production and fill in the values

# ----- DATABASE -----
# Main application database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/simonia

# ----- EVOLUTION DATABASE -----
# WhatsApp Evolution API database (READ-ONLY)
EVOLUTION_DB_HOST=31.97.255.54
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=postgres
EVOLUTION_DB_PASSWORD=your_password

# ----- SECURITY -----
# JWT Secret for authentication (CHANGE THIS!)
# Generate with: openssl rand -base64 48
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production-min-32-chars

# Webhook secrets for HMAC signature verification
EVOLUTION_WEBHOOK_SECRET=your-evolution-webhook-secret-min-32-chars
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret-min-32-chars

# ----- SUPABASE -----
# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ----- VITE (Frontend) -----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ----- GOOGLE OAUTH -----
# Google OAuth 2.0 credentials (optional, for Google login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ----- EVOLUTION API -----
# Evolution API connection (for managing WhatsApp instances)
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_API_TIMEOUT_MS=5000

# ----- UAZAPI -----
# Uazapi API for message sending
UAZAPI_BASE_URL=https://quatro-cinco.uazapi.com

# ----- SERVER -----
PORT=5051
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# ----- CORS -----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ----- OPTIONAL -----
# Allow requests without Origin header (for health checks)
ALLOW_MISSING_ORIGIN=false

# Enable Evolution DB pool health logging
LOG_EVOLUTION_POOL=false

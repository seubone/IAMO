# ============================================================================
# MONITOR IA - PRODUCTION ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================================================
# Copy this file to .env.production on your production server
# Replace all placeholder values with your actual credentials
# NEVER commit .env.production to Git - it's in .gitignore for security

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Main PostgreSQL Database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/simonia

# ============================================================================
# JWT & SECURITY
# ============================================================================

# JWT Secret - Use uma string MUITO FORTE (32+ caracteres)
# Gerar: openssl rand -base64 32
# IMPORTANTE: Nunca use o valor padrão em produção
JWT_SECRET=your-super-secret-jwt-key-32-characters-minimum-change-this

# CORS - Allowed Origins (apenas seus domínios em produção)
ALLOWED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server Port (interno do container - não alterar)
PORT=5051

# Frontend URL (required for email callbacks and auth redirects)
FRONTEND_URL=https://seu-dominio.com

# ============================================================================
# SUPABASE AUTHENTICATION
# ============================================================================

# Obtenha em: https://app.supabase.com/project/[seu-projeto]/settings/api
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# FRONTEND (VITE) ENVIRONMENT VARIABLES
# ============================================================================

# Mesmas chaves do Supabase, prefixadas com VITE_
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# OPTIONAL: EVOLUTION API (WhatsApp)
# ============================================================================

# EVOLUTION_API_URL=https://evolution-api.exemplo.com
# EVOLUTION_API_KEY=sua-chave-api
# EVOLUTION_DB_HOST=host
# EVOLUTION_DB_PORT=5432
# EVOLUTION_DB_NAME=evolution
# EVOLUTION_DB_USER=user
# EVOLUTION_DB_PASSWORD=password

# ============================================================================
# SECURITY NOTES
# ============================================================================
# - Nunca compartilhe este arquivo ou o .env.production
# - Use senhas FORTES (32+ caracteres) para produção
# - Gere novo JWT_SECRET para cada ambiente
# - Mantenha backups das credenciais em local seguro
# - Rotacione senhas periodicamente
# - SEMPRE use HTTPS em produção
# - Regenere as chaves do Supabase regularmente

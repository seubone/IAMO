# ============================================================================
# MONITOR IA - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env on your production VPS
# Replace all placeholder values with your actual credentials

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Main PostgreSQL Database (simonia)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://seu-usuario:sua-senha@seu-host:5432/simonia?sslmode=disable

# ============================================================================
# EVOLUTION API (WhatsApp)
# ============================================================================

EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-api-key-evolution

# Evolution Database Connection
EVOLUTION_DB_HOST=seu-host-evolution
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_NAME=chatwoot
EVOLUTION_DB_USER=seu-usuario-evolution
EVOLUTION_DB_PASSWORD=sua-senha-evolution

# ============================================================================
# UAZAPI (WhatsApp Alternative)
# ============================================================================

UAZAPI_BASE_URL=https://quatro-cinco.uazapi.com

# ============================================================================
# JWT & SECURITY
# ============================================================================

# JWT Secret - Use uma string aleatória FORTE (32+ caracteres)
# Gerar: openssl rand -base64 32
JWT_SECRET=seu-jwt-secret-muito-seguro-de-32-caracteres-ou-mais

# CORS - Allowed Origins (produção: apenas seus domínios)
# Exemplo: https://seu-dominio.com,https://app.seu-dominio.com
ALLOWED_ORIGINS=https://seu-dominio.com

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server Port (interno do container - não alterar)
PORT=5051

# ============================================================================
# SUPABASE AUTHENTICATION
# ============================================================================

# Obtenha em: https://app.supabase.com/project/[seu-projeto]/settings/api
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada-de-servico

# ============================================================================
# FRONTEND (VITE) ENVIRONMENT VARIABLES
# ============================================================================

# Mesmas chaves do Supabase, prefixadas com VITE_
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# ============================================================================
# OPTIONAL: TEST/DEBUG VARIABLES
# ============================================================================

# Descomente apenas se for usar scripts de teste em produção
# TEST_MESSAGE_TOKEN=seu-token-jwt
# SYNC_INSTANCES_TOKEN=seu-token-jwt
# EVOLUTION_API_TEST=false

# ============================================================================
# NOTES
# ============================================================================
# - Nunca compartilhe este arquivo
# - Use senhas FORTES (32+ caracteres) para produção
# - Gere novo JWT_SECRET para cada ambiente
# - Mantenha backups das credenciais em local seguro
# - Rotacione senhas periodicamente
# - Use .env.production no arquivo .gitignore

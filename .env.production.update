# ============================================================================
# ATUALIZAÇÕES NECESSÁRIAS PARA O .env.production NO SERVIDOR
# ============================================================================
# Copie APENAS as linhas abaixo para seu .env.production e atualize os valores

# 1. GERE UM NOVO JWT_SECRET FORTE
# No seu servidor, rode:
# openssl rand -base64 32
# Depois substitua o valor abaixo:
JWT_SECRET=USE_OPENSSL_RAND_BASE64_32_TO_GENERATE_A_SECURE_VALUE

# 2. ADICIONE O FRONTEND_URL COM SEU DOMÍNIO
# Substitua 'seu-dominio.com' pelo domínio real da sua aplicação:
FRONTEND_URL=https://seu-dominio.com

# ============================================================================
# VERIFICAÇÃO DE SEGURANÇA
# ============================================================================
# Após atualizar, verifique se seu .env.production tem:
# ✓ JWT_SECRET com 32+ caracteres (gerado com openssl)
# ✓ FRONTEND_URL apontando para o domínio correto
# ✓ ALLOWED_ORIGINS com os domínios corretos
# ✓ DATABASE_URL correto
# ✓ Supabase keys atualizadas (se regeneradas após vazamento)

# ============================================================================
# MONITOR IA - ENVIRONMENT VARIABLES EXAMPLE
# ============================================================================
# Copy this file to .env and fill in your actual values
# For production, create .env.production with real credentials

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server Port (backend API) - default 5051
PORT=5051

# Node Environment
NODE_ENV=development

# Frontend URL (for email callbacks and auth redirects)
# In production: https://seu-dominio.com/
FRONTEND_URL=http://localhost:5000

# Server Type and URL
SERVER_TYPE=http
SERVER_URL=http://localhost:5051

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Main Database (PostgreSQL) - OPTIONAL
# If not provided, the application will automatically use Evolution DB
# Format: postgresql://user:password@host:port/database
# Leave commented to use Evolution DB as primary database (recommended for production)
# DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/monitor_ia?sslmode=disable

# ============================================================================
# EVOLUTION API (WhatsApp)
# ============================================================================

# Evolution API Configuration
# Example: https://eve.seubone.com
EVOLUTION_API_URL=https://seu-evolution-api.com
# Example: 429683C4C977415CAAFCCE10F7D57E11
EVOLUTION_API_KEY=sua-api-key-aqui

# Evolution Database (WhatsApp) - PRIMARY DATABASE (REQUIRED)
# This database is used for all application data including:
# - WhatsApp instances and messages
# - Bot status (instance_bot_status table)
# - Contact status (instance_contact_status table)
# - All other application tables
EVOLUTION_DB_HOST=localhost
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=postgres
EVOLUTION_DB_PASSWORD=sua_senha_aqui

# ============================================================================
# UAZAPI (WhatsApp Alternative)
# ============================================================================

UAZAPI_BASE_URL=https://quatro-cinco.uazapi.com

# ============================================================================
# JWT & SECURITY
# ============================================================================

# JWT Secret - MUST be 32+ characters and CHANGED in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-jwt-aqui-minimo-32-caracteres-aleatorio

# Webhook Secrets - For HMAC signature verification
# Generate with: openssl rand -hex 32
# Evolution API will send X-Webhook-Signature header with HMAC-SHA256
EVOLUTION_WEBHOOK_SECRET=sua-chave-webhook-evolution-aqui-64-caracteres-hex
# N8N workflows will send X-Webhook-Signature header with HMAC-SHA256
N8N_WEBHOOK_SECRET=sua-chave-webhook-n8n-aqui-64-caracteres-hex

# CORS - Allowed Origins (comma-separated)
# In production, specify only your allowed URLs
# Example: ALLOWED_ORIGINS=https://seu-dominio.com,https://app.seu-dominio.com
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:5051,http://127.0.0.1:5000,http://127.0.0.1:5173

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE
LOG_COLOR=true
LOG_BAILEYS=error
SENTRY_DSN=

# ============================================================================
# SUPABASE AUTHENTICATION
# ============================================================================

# Get these credentials from: https://app.supabase.com/project/[seu-projeto]/settings/api
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# ============================================================================
# VITE FRONTEND ENVIRONMENT VARIABLES
# ============================================================================

# Same Supabase credentials but prefixed with VITE_ for frontend exposure
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# ============================================================================
# TEST/DEBUG VARIABLES (Development only)
# ============================================================================

TEST_MESSAGE_TOKEN=seu-jwt-token-aqui
SYNC_INSTANCES_TOKEN=seu-jwt-token-aqui
TEST_INSTANCE_NUMBER=5584987168184
TEST_RECIPIENT_NUMBER=558498973484
AUTH_TOKEN=seu-token-de-autenticacao-aqui

# ============================================================================
# PRODUCTION SECURITY NOTES
# ============================================================================
# 1. Generate a STRONG JWT_SECRET: openssl rand -base64 32
# 2. Set NODE_ENV=production in production
# 3. Use HTTPS URLs only (https://)
# 4. Specify ALLOWED_ORIGINS properly (not *)
# 5. Regenerate Supabase keys if they are ever exposed
# 6. Never commit .env or .env.production to git
# 7. Ensure EVOLUTION_DB_* credentials are correct (primary database)
# 8. Keep credentials secure and rotate periodically
# 9. DATABASE_URL is optional - omit it to use Evolution DB automatically

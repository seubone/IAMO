# Main Database (PostgreSQL)
# Use um banco separado 'monitor_ia' no mesmo servidor do Evolution
DATABASE_URL=postgresql://usuario:senha@host:5432/monitor_ia?sslmode=disable

# Evolution Database (WhatsApp)
EVOLUTION_DB_HOST=localhost
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_NAME=chatwoot
EVOLUTION_DB_USER=postgres
EVOLUTION_DB_PASSWORD=sua_senha_aqui

# JWT Secret
# Use uma string aleatória forte (32+ caracteres)
# IMPORTANTE: Troque em produção! Nunca use a senha de desenvolvimento!
JWT_SECRET=sua-chave-secreta-jwt-aqui-minimo-32-caracteres

# Server Port
PORT=5000

# CORS - Allowed Origins (comma-separated)
# Em produção, especifique apenas suas URLs permitidas
# Exemplo: ALLOWED_ORIGINS=https://seu-dominio.com,https://app.seu-dominio.com
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# Uazapi API Configuration
# URL base da API Uazapi (geralmente não precisa mudar)
UAZAPI_BASE_URL=https://quatro-cinco.uazapi.com

# Supabase Authentication (Cloud Database for Users)
# Obtenha essas credenciais em: https://app.supabase.com/project/[seu-projeto]/settings/api
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui
